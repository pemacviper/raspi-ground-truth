  "rules": [
    {
      "rule_key": "medical_billing_intermediary",
      "priority": 10,
      "description": "PVS Südwest, PVS dental und DZR sind bei medizinischen Rechnungen typischerweise Abrechnungsstellen. Für die Ablage tatsächlichen Arzt/Zahnarzt/Leistungserbringer und betroffene Person bestimmen."
    },
    {
      "rule_key": "sender_not_destination",
      "priority": 20,
      "description": "Absender und Ablageziel sind getrennte Konzepte. Nicht automatisch einen Ordner nach dem Absender wählen."
    },
    {
      "rule_key": "canonical_folder_first",
      "priority": 30,
      "description": "Einen bestehenden kanonischen Ordner bevorzugen. Neue Ordner nur bei hoher Sicherheit und wenn kein passender kanonischer Ordner existiert."
    },
    {
      "rule_key": "generic_folder_last_resort",
      "priority": 40,
      "description": "Generische Sammelordner wie Versicherungen oder Sonstige Rechnungen sind nur Fallback, wenn kein konkreter fachlicher Kontext sicher erkennbar ist."
    },
    {
      "rule_key": "no_guessing",
      "priority": 50,
      "description": "Bei unzureichender Evidenz keine Zuordnung erfinden. Unsichere Dokumente zur Prüfung in der ScanSnap Inbox belassen."
    },
    {
      "rule_key": "deuev_social_insurance",
      "description": "Bescheinigungen/Meldungen zur Sozialversicherung nach § 28a Abs. 5 SGB IV bzw. DEÜV werden bei eindeutiger Dokumentevidenz im kanonischen Ordner Sozialversicherung abgelegt. Der Arbeitgeber ist Absender/Arbeitgeberkontext, nicht Ablageziel.",
      "priority": 15
    },
    {
      "rule_key": "no_automatic_folder_creation",
      "description": "Der ScanSnap-Workflow darf niemals selbstständig neue Drive-Ordner anlegen. Wenn kein bestehender kanonischer/live Ordner sicher passt, ist human_review erforderlich.",
      "priority": 5
    },
    {
      "rule_key": "human_folder_learning_loop",
      "description": "Ein neuer Ordner wird erst nach expliziter Nutzerentscheidung in Drive angelegt. Danach wird er via /register-folder als canonical_folder registriert und die konkrete Zuordnung via /confirm als ground_truth_case gespeichert. Erst folgende Läufe dürfen ihn automatisch verwenden.",
      "priority": 6
    },
    {
      "rule_key": "drv_renteninformation_exact_target",
      "description": "Renteninformation und Rentenauskunft der Deutschen Rentenversicherung Bund werden bei eindeutiger Evidenz in den bestehenden kanonischen Ordner # Versicherungen / Rentenversicherung Bund abgelegt.",
      "priority": 10
    },
    {
      "rule_key": "zvr_not_medical_befund",
      "description": "Schreiben des Zentralen Vorsorgeregisters/Bundesnotarkammer zu Vorsorgevollmacht, Vertrauensperson oder Betreuung sind keine medizinischen Befunde. Bei passender Evidenz ist der bestehende Vorsorge-/Vollmacht-Kontext zu verwenden.",
      "priority": 10
    }
  ],
