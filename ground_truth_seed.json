  "rules": [
    {
      "rule_key": "medical_billing_intermediary",
      "priority": 10,
      "description": "PVS Südwest, PVS dental und DZR sind bei medizinischen Rechnungen typischerweise Abrechnungsstellen. Für die Ablage tatsächlichen Arzt/Zahnarzt/Leistungserbringer und betroffene Person bestimmen."
    },
    {
      "rule_key": "sender_not_destination",
      "priority": 20,
      "description": "Absender und Ablageziel sind getrennte Konzepte. Nicht automatisch einen Ordner nach dem Absender wählen."
    },
    {
      "rule_key": "canonical_folder_first",
      "priority": 30,
      "description": "Einen bestehenden kanonischen Ordner bevorzugen. Neue Ordner nur bei hoher Sicherheit und wenn kein passender kanonischer Ordner existiert."
    },
    {
      "rule_key": "generic_folder_last_resort",
      "priority": 40,
      "description": "Generische Sammelordner wie Versicherungen oder Sonstige Rechnungen sind nur Fallback, wenn kein konkreter fachlicher Kontext sicher erkennbar ist."
    },
    {
      "rule_key": "no_guessing",
      "priority": 50,
      "description": "Bei unzureichender Evidenz keine Zuordnung erfinden. Unsichere Dokumente zur Prüfung in der ScanSnap Inbox belassen."
    }
  ],
